<Project>
  <!-- Shared settings for every .NET project in the lab.
       Having this file here also stops MSBuild from picking up any props files in parent folders. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
