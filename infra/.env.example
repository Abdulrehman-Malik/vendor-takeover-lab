# infra/.env is generated by scripts/bootstrap.sh with random passwords and is NOT committed.
# This example shows its shape. Every service in stack.yml loads the whole file with env_file,
# which is exactly the "secrets in .env files" practice the takeover team is looking for.
MSSQL_SA_PASSWORD=<generated>
MINIO_ROOT_USER=labadmin
MINIO_ROOT_PASSWORD=<generated>
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<generated>
ConnectionStrings__Sales=Server=sqlserver,1433;Database=SalesDb;User Id=sa;Password=<generated>;TrustServerCertificate=True
ConnectionStrings__Customers=Server=sqlserver,1433;Database=CustomersDb;User Id=sa;Password=<generated>;TrustServerCertificate=True
ConnectionStrings__Documents=Server=sqlserver,1433;Database=DocumentsDb;User Id=sa;Password=<generated>;TrustServerCertificate=True
Minio__AccessKey=labadmin
Minio__SecretKey=<generated>
